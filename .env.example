# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha os valores
# antes de rodar `docker compose up`. Nunca commite o arquivo ".env" de verdade.

# Chave simétrica usada para assinar/validar os JWT em todos os serviços. Gere uma string
# aleatória longa (ex.: `openssl rand -base64 48`) — qualquer valor serve para desenvolvimento
# local, mas NUNCA reutilize um valor de exemplo em produção.
JWT_KEY=troque-por-uma-chave-aleatoria-longa-e-secreta-0123456789

# Senha da conta de serviço "service-consolidacao" (perfil Admin, seed em
# Auth.Infrastructure/Persistence/AuthDbContext.cs), usada por Relatorios.Api e
# Consolidacao.BackgroundServices como FALLBACK de autenticação entre serviços (só é usada se
# SERVICE_ACCOUNT_TOKEN estiver vazio/expirado — ver README, seção "Conta de serviço").
SERVICE_ACCOUNT_SENHA=ServiceConsolidacao@123

# Token JWT de longa duração da conta de serviço, gerado uma vez via POST /api/auth/login e
# colado aqui — evita logins repetidos a cada chamada entre serviços. Pode ficar vazio na
# primeira subida: o sistema faz login automaticamente como fallback e usa SERVICE_ACCOUNT_SENHA
# até você colar um token aqui. Ver README, seção "Conta de serviço", para o passo a passo.
SERVICE_ACCOUNT_TOKEN=
