{
  "_comentario": "Carregado quando ASPNETCORE_ENVIRONMENT=Production (usado no docker-compose) — aponta para os nomes de serviço da rede Docker. financeiro e relatorios têm 2 nós cada (Especificação Mestre, seção 7/38).",
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": { "Address": "http://auth-api:8080/" }
        }
      },
      "financeiro-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "financeiro-api-1": { "Address": "http://financeiro-api-1:8080/" },
          "financeiro-api-2": { "Address": "http://financeiro-api-2:8080/" }
        }
      },
      "relatorios-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "relatorios-api-1": { "Address": "http://relatorios-api-1:8080/" },
          "relatorios-api-2": { "Address": "http://relatorios-api-2:8080/" }
        }
      }
    }
  },
  "Otel": {
    "Endpoint": "http://aspire-dashboard:18889"
  }
}
