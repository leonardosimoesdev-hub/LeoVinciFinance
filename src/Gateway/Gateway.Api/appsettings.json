{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otel": {
    "Endpoint": "http://localhost:18889"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "financeiro-route": {
        "ClusterId": "financeiro-cluster",
        "Match": { "Path": "/api/financeiro/{**catch-all}" }
      },
      "relatorios-route": {
        "ClusterId": "relatorios-cluster",
        "Match": { "Path": "/api/relatorios/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "_comentario": "Auth.Api: 1 instância nesta fase (docs/architecture/architecture.md, seção 2).",
        "Destinations": {
          "auth-api": { "Address": "http://localhost:5001/" }
        }
      },
      "financeiro-cluster": {
        "_comentario": "2 nós (Especificação Mestre, seção 7/38: 'cada API HTTP deverá possuir duas instâncias'). Em desenvolvimento local sem Docker, suba uma segunda instância com --urls apontando para a porta 5012 (ver README) para exercitar o balanceamento.",
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "financeiro-api-1": { "Address": "http://localhost:5002/" },
          "financeiro-api-2": { "Address": "http://localhost:5012/" }
        }
      },
      "relatorios-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "relatorios-api-1": { "Address": "http://localhost:5003/" },
          "relatorios-api-2": { "Address": "http://localhost:5013/" }
        }
      }
    }
  }
}
